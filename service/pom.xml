<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.paystruct</groupId>
  <artifactId>paystruct-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>paystruct-service</name>
  <description>ISO 20022 address structuring engine</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Boot 3.5.6 manages 1.21.3, whose Docker client gets HTTP 400 from Docker Engine 29. -->
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- JAXB (jakarta namespace) for the classes generated from the XSDs -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Unit tests (*Test) run with `test`; integration tests (*IT, need Docker) run with `verify`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- xjc: one execution per schema, each into its own package so the two
           Document trees do not collide. Source of truth: src/main/resources/xsd. -->
      <plugin>
        <groupId>org.jvnet.jaxb</groupId>
        <artifactId>jaxb-maven-plugin</artifactId>
        <version>4.0.8</version>
        <executions>
          <execution>
            <id>xjc-pacs008</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <schemaDirectory>src/main/resources/xsd</schemaDirectory>
              <schemaIncludes><include>pacs.008.001.14.xsd</include></schemaIncludes>
              <generatePackage>com.paystruct.xml.pacs008</generatePackage>
              <generateDirectory>${project.build.directory}/generated-sources/xjc-pacs008</generateDirectory>
              <episode>false</episode>
            </configuration>
          </execution>
          <execution>
            <id>xjc-pain001</id>
            <goals><goal>generate</goal></goals>
            <configuration>
              <schemaDirectory>src/main/resources/xsd</schemaDirectory>
              <schemaIncludes><include>pain.001.001.13.xsd</include></schemaIncludes>
              <generatePackage>com.paystruct.xml.pain001</generatePackage>
              <generateDirectory>${project.build.directory}/generated-sources/xjc-pain001</generateDirectory>
              <episode>false</episode>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
